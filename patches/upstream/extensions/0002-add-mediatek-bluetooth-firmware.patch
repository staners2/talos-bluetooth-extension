new file mode 100644
index 0000000..91d578e
--- /dev/null
+++ b/firmware/mediatek-bluetooth-firmware/pkg.yaml
@@ -0,0 +1,30 @@
+name: mediatek-bluetooth-firmware
+variant: scratch
+shell: /bin/bash
+dependencies:
+  - stage: base
+  - image: "{{ .BUILD_ARG_PKGS_PREFIX }}/linux-firmware:{{ .BUILD_ARG_PKGS }}"
+steps:
+  - install:
+      - |
+        install -D -m 0644 \
+          /usr/lib/firmware/mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin \
+          /rootfs/usr/lib/firmware/mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin
+        install -D -m 0644 \
+          /usr/lib/firmware/LICENSES/LICENCE.mediatek \
+          /rootfs/usr/lib/firmware/LICENSES/LICENCE.mediatek
+    test:
+      - |
+        test -s /rootfs/usr/lib/firmware/mediatek/BT_RAM_CODE_MT7922_1_1_hdr.bin
+        test -s /rootfs/usr/lib/firmware/LICENSES/LICENCE.mediatek
+        test "$(find /rootfs/usr/lib/firmware/mediatek -type f | wc -l)" -eq 1
+      - |
+        mkdir -p /extensions-validator-rootfs
+        cp -r /rootfs/ /extensions-validator-rootfs/rootfs
+        cp /pkg/manifest.yaml /extensions-validator-rootfs/manifest.yaml
+        /extensions-validator validate --rootfs=/extensions-validator-rootfs --pkg-name="${PKG_NAME}"
+finalize:
+  - from: /rootfs
+    to: /rootfs
+  - from: /pkg/manifest.yaml
+    to: /
